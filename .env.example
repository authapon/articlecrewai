# คัดลอกไฟล์นี้เป็น .env แล้วแก้เฉพาะค่าที่ต้องการเปลี่ยน
#   cp .env.example .env
# ค่าที่ไม่ตั้งหรือเว้นว่างไว้ จะใช้ค่า default (ตามที่เขียนไว้ด้านล่าง)
# environment variable ของระบบ/เชลล์ จะมีความสำคัญเหนือค่าในไฟล์นี้

# ---------- LLM (LM Studio แบบ OpenAI API compatible) ----------
# ชื่อโมเดล: prefix "openai/" + id ที่ได้จาก GET /v1/models
CREW_MODEL=openai/qwen3.5-4b
# base URL ต้องลงท้ายด้วย /v1
LMSTUDIO_BASE_URL=http://127.0.0.1:14900/v1
# LM Studio ไม่ตรวจ key แต่ต้องมีค่า
LMSTUDIO_API_KEY=lm-studio
CREW_TEMPERATURE=0.3
# จำนวน token สูงสุดต่อการตอบ (ต้องตั้งใน LM Studio ให้รองรับด้วย)
CREW_MAX_TOKENS=8192

# ---------- SearXNG ----------
SEARXNG_URL=http://127.0.0.1:3001
SEARXNG_TIMEOUT=20
SEARXNG_MAX_RESULTS=5
# ภาษาของผลค้นหา เช่น th, en, auto (ว่าง = ไม่ระบุ)
SEARXNG_LANGUAGE=

# ---------- Web fetch ----------
WEB_FETCH_TIMEOUT=20
WEB_FETCH_MAX_BYTES=2000000
# จำนวนตัวอักษรสูงสุดของเนื้อหาเว็บต่อหน้า (ลดลงถ้า context ของโมเดลเล็ก)
WEB_FETCH_MAX_CHARS=6000
WEB_FETCH_MAX_REDIRECTS=3
WEB_FETCH_USER_AGENT=Mozilla/5.0 (compatible; ArticleCrewBot/1.0)
# อนุญาตให้ดึงจาก localhost/เครือข่ายภายใน (ปกติปิดไว้เพื่อความปลอดภัย)
ALLOW_PRIVATE_FETCH=false

# ---------- File output ----------
# path แบบ relative จะอิงจากโฟลเดอร์โปรเจกต์
ARTICLE_OUTPUT_DIR=output
# ขั้นต่ำของความยาวบทความ (ตัวอักษร) ที่ file_write ยอมบันทึก
MIN_ARTICLE_CHARS=500

# ---------- Crew / บทความที่ต้องการ ----------
CREW_VERBOSE=true
ARTICLE_TOPIC=แนวโน้ม Local LLM สำหรับงาน Edge AI
ARTICLE_AUDIENCE=นักศึกษาและนักพัฒนาซอฟต์แวร์
ARTICLE_LANGUAGE=ภาษาไทย (ศัพท์เทคนิคใช้ภาษาอังกฤษได้)

# ---------- อื่น ๆ (ไม่บังคับ) ----------
# ปิด telemetry ของ CrewAI
# OTEL_SDK_DISABLED=true
